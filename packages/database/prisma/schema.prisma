generator client {
  provider = "prisma-client"
  output   = "./../src/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  passwordHash  String?         @map("password_hash")
  avatarUrl        String?
  emailVerifiedAt  DateTime?
  twoFactorSecret     String?  @map("two_factor_secret")
  twoFactorEnabled    Boolean  @default(false) @map("two_factor_enabled")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  projects        Project[]
  refreshTokens   RefreshToken[]
  oauthAccounts   OAuthAccount[]  
  projectMembers  ProjectMember[]
  projectMessages ProjectMessage[]

  @@map("users")
}

model OAuthAccount {
  id                String   @id @default(uuid())

  provider          String
  providerAccountId String

  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?

  userId            String
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  revoked   Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  ownerId     String   @map("owner_id")
  isPrivate   Boolean  @default(false) @map("is_private")
  password    String?  @map("password")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  schema      Schema?

  projectMembers  ProjectMember[]
  projectMessages ProjectMessage[]

  @@index([ownerId])
  @@map("projects")
}

model StarterTemplateSchema {
  id              String          @id  @default(uuid())
  name            String
  description     String?
  image           String?
  dbml            String          @default("")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
}

/// One active DBML schema document per project (1:1). Historical states
/// are kept in SchemaVersion for undo/redo and audit-free history.
model Schema {
  id        String          @id @default(uuid())
  projectId String          @unique @map("project_id")
  dbml      String          @default("")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  versions  SchemaVersion[]
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("schemas")
}

model SchemaVersion {
  id        String   @id @default(uuid())
  schemaId  String   @map("schema_id")
  dbml      String
  label     String?
  createdAt DateTime @default(now()) @map("created_at")
  schema    Schema   @relation(fields: [schemaId], references: [id], onDelete: Cascade)

  @@index([schemaId, createdAt])
  @@map("schema_versions")
}


model ProjectMember {
  id        String  @id  @default(uuid())
  projectId String
  userId    String
  role      ProjectRole    @default(MEMBER)  // OWNER, ADMIN, MEMBER
  joinedAt  DateTime    @default(now()) @map("joined_at")

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("project_members") 
  @@unique([projectId, userId])
}

model ProjectMessage {
  id        String   @id @default(uuid())
  projectId    String
  userId    String
  content   String
  type      MessageType   @default(TEXT)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sender    User      @relation(fields: [userId], references: [id], onDelete: Cascade)  

  @@map("project_messages")
  @@index([projectId, createdAt])
}


enum ProjectRole {
  OWNER 
  ADMIN 
  MEMBER
}

enum MessageType {
  TEXT
  SYSTEM
  ACTION
}