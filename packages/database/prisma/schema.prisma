generator client {
  provider = "prisma-client"
  output   = "./../src/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  passwordHash  String?         @map("password_hash")
  avatarUrl        String?
  emailVerifiedAt  DateTime?
  twoFactorSecret     String?  @map("two_factor_secret")
  twoFactorEnabled    Boolean  @default(false) @map("two_factor_enabled")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  projects        Project[]
  refreshTokens   RefreshToken[]
  oauthAccounts   OAuthAccount[]  
  projectMembers  ProjectMember[]
  projectMessages ProjectMessage[]
  projectFavorites ProjectFavorite[]
  tableLocks      TableLock[]

  @@map("users")
}

model OAuthAccount {
  id                String   @id @default(uuid())

  provider          String
  providerAccountId String

  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?

  userId            String
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  revoked   Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Project {
  id           String    @id @default(uuid())
  name         String
  description  String?
  ownerId      String    @map("owner_id")
  isPrivate    Boolean   @default(false) @map("is_private")
  password     String?   @map("password")
  forkedFromId String?   @map("forked_from_id")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  owner        User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  schema       Schema?
  forkedFrom   Project?  @relation("ProjectFork", fields: [forkedFromId], references: [id], onDelete: SetNull)
  forks        Project[] @relation("ProjectFork")

  projectMembers  ProjectMember[]
  projectMessages ProjectMessage[]
  invites         ProjectInvite[]
  favorites       ProjectFavorite[]
  tableLocks      TableLock[]

  @@index([ownerId])
  @@index([deletedAt])
  @@map("projects")
}

model StarterTemplateSchema {
  id              String          @id  @default(uuid())
  name            String
  description     String?
  image           String?
  dbml            String          @default("")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
}

/// One active DBML schema document per project (1:1). Historical states
/// are kept in SchemaVersion for undo/redo and audit-free history.
model Schema {
  id        String          @id @default(uuid())
  projectId String          @unique @map("project_id")
  dbml      String          @default("")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  versions  SchemaVersion[]
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("schemas")
}

model SchemaVersion {
  id        String   @id @default(uuid())
  schemaId  String   @map("schema_id")
  dbml      String
  label     String?
  createdAt DateTime @default(now()) @map("created_at")
  schema    Schema   @relation(fields: [schemaId], references: [id], onDelete: Cascade)

  @@index([schemaId, createdAt])
  @@map("schema_versions")
}


model ProjectMember {
  id        String  @id  @default(uuid())
  projectId String
  userId    String
  role      ProjectRole    @default(VIEWER)  // OWNER, EDITOR, VIEWER
  joinedAt  DateTime    @default(now()) @map("joined_at")

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("project_members") 
  @@unique([projectId, userId])
}

model ProjectInvite {
  id        String       @id @default(uuid())
  projectId String       @map("project_id")
  email     String
  role      ProjectRole  @default(VIEWER)
  token     String       @unique
  status    InviteStatus @default(PENDING)
  invitedBy String       @map("invited_by")
  expiresAt DateTime     @map("expires_at")
  createdAt DateTime     @default(now()) @map("created_at")

  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([email])
  @@map("project_invites")
}

model ProjectFavorite {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_favorites")
}

/// A soft, per-table "checkout" lock — enforced identically by the REST API
/// and the websocket gateway so a user can't bypass it by only using one.
model TableLock {
  id         String   @id @default(uuid())
  projectId  String   @map("project_id")
  tableName  String   @map("table_name")
  userId     String   @map("user_id")
  acquiredAt DateTime @default(now()) @map("acquired_at")
  expiresAt  DateTime @map("expires_at")

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, tableName])
  @@map("table_locks")
}

model ProjectMessage {
  id        String   @id @default(uuid())
  projectId    String
  userId    String
  content   String
  type      MessageType   @default(TEXT)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sender    User      @relation(fields: [userId], references: [id], onDelete: Cascade)  

  @@map("project_messages")
  @@index([projectId, createdAt])
}


enum ProjectRole {
  OWNER
  EDITOR
  VIEWER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum MessageType {
  TEXT
  SYSTEM
  ACTION
}